import type { Difficulty, Lesson, Module, ModuleStatus, Resource, Track } from './curriculum'

/**
 * Language tracks are kept in their own module so the growing catalog stays
 * readable. They use the same Lesson/Module/Track shape as the web tracks, so
 * progress, search, sitemap, and lesson rendering work without special cases.
 */

const docs = (title: string, url: string, provider: string): Resource => ({
  type: 'docs',
  title,
  url,
  provider,
  isVerified: true,
})

const practice = (title: string, url: string, provider: string): Resource => ({
  type: 'interactive',
  title,
  url,
  provider,
  isVerified: true,
})

const lesson = (
  id: string,
  title: string,
  description: string,
  order: number,
  estimatedMinutes: number,
  difficulty: Difficulty,
  xpReward: number,
  keyTakeaways: string[],
  resources: Resource[]
): Lesson => ({
  id,
  title,
  description,
  order,
  estimatedMinutes,
  difficulty,
  xpReward,
  keyTakeaways,
  resources,
  isProject: id.includes('project') || id.includes('capstone'),
})

const moduleDef = (
  id: string,
  name: string,
  description: string,
  order: number,
  estimatedHours: number,
  color: string,
  lessons: Lesson[],
  status?: ModuleStatus,
  isExperimental?: boolean
): Module => ({
  id,
  key: id,
  name,
  description,
  order,
  estimatedHours,
  icon: 'FileCode',
  color,
  lessons,
  status,
  isExperimental,
})

