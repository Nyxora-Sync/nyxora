# ---------------------------------------------------------------------------
# Database (Neon, Supabase, or any PostgreSQL provider)
# ---------------------------------------------------------------------------
# Runtime URL — use the *pooled* connection string in serverless environments.
# Neon example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mern_learn?schema=public"

# Direct (unpooled) URL — used by `prisma migrate` and `prisma studio`.
# Can be identical to DATABASE_URL for a local database.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mern_learn?schema=public"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-in-production-min-32-chars"

# Public URL of the app (no trailing slash). On Vercel this is detected
# automatically, but setting it explicitly is recommended.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Canonical public origin for sitemap, canonical tags, social images, and newsletter links.
# Leave empty on Vercel to use VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# GitHub OAuth — https://github.com/settings/developers
# Create one OAuth App for local dev and one for production.
# Local callback URL:      http://localhost:3000/api/auth/callback/github
# Production callback URL: https://your-domain.com/api/auth/callback/github
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Google OAuth — https://console.cloud.google.com (optional)
# Callback: https://your-domain.com/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email (optional) — magic links, contact notifications, and the newsletter
# when it is re-enabled in src/lib/newsletter-feature.ts
# ---------------------------------------------------------------------------
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="MERN Learn <noreply@localhost>"
# Where contact-form notifications are sent. Falls back to EMAIL_FROM.
CONTACT_INBOX=""
# Legacy URL form accepted by Auth.js, e.g. smtp://user:pass@host:587
EMAIL_SERVER=""

# Newsletter-only settings. The feature is currently disabled in
# src/lib/newsletter-feature.ts; these values are reserved for re-enabling it.
# Comma-separated account emails allowed to open /admin/newsletter and send
# broadcasts. Matching is case-insensitive. Leave empty to disable the admin.
ADMIN_EMAILS=""

# Optional separate HMAC secret for confirmation and unsubscribe links.
# Falls back to AUTH_SECRET. Rotating it invalidates links already in inboxes.
NEWSLETTER_SECRET=""
